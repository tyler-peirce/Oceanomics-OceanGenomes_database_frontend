DJANGO_SECRET_KEY=change-this-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL settings for the Django app database.
APP_POSTGRES_DB=oceanomics_frontend
APP_POSTGRES_USER=postgres
APP_POSTGRES_PASSWORD=change-this-password
APP_POSTGRES_HOST=localhost
APP_POSTGRES_PORT=5432

# PostgreSQL settings for the live Oceanomics explorer connection.
OCEANOMICS_POSTGRES_DB=oceanomics_genomes
OCEANOMICS_POSTGRES_USER=postgres
OCEANOMICS_POSTGRES_PASSWORD=change-this-password
OCEANOMICS_POSTGRES_HOST=localhost
OCEANOMICS_POSTGRES_PORT=5432

# Backward-compatible fallback for the explorer connection if the OCEANOMICS_*
# variables are not set.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Path to the exported schema CSV used by the explorer UI.
SCHEMA_METADATA_PATH=/Users/tylerpeirce/oceanomics_db_frontend/db_schema.csv
